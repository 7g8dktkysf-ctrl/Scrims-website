<script>

function toggleMenu() {
    document.getElementById("navLinks").classList.toggle("active");
}

function closeModal() {
    document.getElementById("modal").classList.remove("active");
}

function showTeams(time) {

    document.getElementById("modalContent").innerHTML = `
        <div class="section-label">REGISTERED TEAMS</div>
        <h2>${time}</h2>

        <p>
        No teams have registered for this session yet.
        </p>

        <div class="team-list">
            <div class="team">01 — Waiting for registration</div>
        </div>

        <div style="margin-top:25px;">
            <button class="small-btn" onclick="closeModal()">
                ← BACK
            </button>
        </div>
    `;

    document.getElementById("modal").classList.add("active");
}

function showDetails(time) {

    document.getElementById("modalContent").innerHTML = `
        <div class="section-label">SCRIM DETAILS</div>

        <h2>${time}</h2>

        <p>
        Competitive scrim session hosted by IND ESPORTS.
        Check the session information before entering.
        </p>

        <div class="team-list">

            <div class="team">
                <strong>TEAM CAPACITY</strong><br>
                22 Teams
            </div>

            <div class="team">
                <strong>DROP</strong><br>
                Drop information will be displayed here.
            </div>

            <div class="team">
                <strong>RULES</strong><br>
                Follow all IND ESPORTS competitive guidelines.
            </div>

        </div>

        <div class="card-buttons">

            <button class="small-btn" onclick="closeModal()">
                ← BACK
            </button>

        </div>
    `;

    document.getElementById("modal").classList.add("active");
}

document.getElementById("modal").addEventListener("click", function(e) {

    if(e.target === this) {
        closeModal();
    }

});

</script>

